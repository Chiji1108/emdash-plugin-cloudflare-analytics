{
	"name": "@chiji1108/emdash-plugin-cloudflare-analytics",
	"version": "0.5.1",
	"description": "Cloudflare Web Analytics in the EmDash admin",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"cloudflare",
		"analytics"
	],
	"license": "MIT",
	"author": "Chiji (https://chiji.tech)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Chiji1108/emdash-plugin-cloudflare-analytics.git"
	},
	"type": "module",
	"packageManager": "pnpm@12.17.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"release:setup": "emdash-plugin release setup",
		"registry:login": "emdash-plugin login",
		"registry:publish": "emdash-plugin publish",
		"prepublishOnly": "pnpm run validate && pnpm run typecheck && pnpm run build"
	},
	"peerDependencies": {
		"emdash": ">=1.4.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "^1.4.0",
		"@emdash-cms/plugin-cli": "0.13.5",
		"@emdash-cms/plugin-test": "^0.2.6",
		"emdash": "^1.4.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0",
		"zod": "^4.6.7"
	}
}
